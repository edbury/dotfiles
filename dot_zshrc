# Chrome OS Only
if [ -e ~/.nix-profile/etc/profile.d/nix.sh ]; then . ~/.nix-profile/etc/profile.d/nix.sh; fi # added by Nix installer

if [ $TILIX_ID ] || [ $VTE_VERSION ]; then
    source /etc/profile.d/vte.sh
fi

if ! (( $+commands[pbcopy] )); then
   if (( $+commands[termux-clipboard-set] )); then
      alias pbcopy='termux-clipboard-set'
      alias pbpaste='termux-clipboard-get'
   else
      alias pbcopy='xclip -selection clipboard'
      alias pbpaste='xclip -selection clipboard -o'
   fi
fi

# Browser

if [[ "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

# Editors

export EDITOR='nvim'
export VISUAL='nvim'
export PAGER='less'

# Language

if [[ -z "$LANG" ]]; then
  export LANG='en_US.UTF-8'
fi

# disable zsh escapes
DISABLE_MAGIC_FUNCTIONS=true

# Import dotfile scripts
export PATH="$HOME/bin:/usr/local/sbin:$PATH"
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# Plugins, bundled from ~/.zsh_plugins.txt by antidote
source ~/.zsh_plugins.sh

unsetopt AUTO_CD


## ls / ll
alias ll='ls -lhFG'

## Brew Bundle
alias brewup='brew update; brew upgrade; brew cleanup; brew doctor'

(( $+commands[rbenv] )) && eval "$(rbenv init - zsh)"
export NVM_DIR="$HOME/.nvm"

if [[ "$PREFIX" == *com.termux* ]]; then
  # Dropsync keeps the vault in shared storage
  alias vault='cd ~/storage/shared/vaults/garden && nvim'

  # Termux doesn't keep terminal colors between sessions, so reapply tinty's last scheme
  (( $+commands[tinty] )) && tinty init
fi
